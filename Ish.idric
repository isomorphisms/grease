module Ish

import Ish.Cast_incantation
import Ish.Receive_incantation
import Ish.Understand_incantation

-- A shell receives source describing an incantation, understands that
-- incantation and its inputs, then casts it so its action occurs. This
-- executable slice casts one external program by replacing the shell process.
main : IO ()
main = do
  source ← receive_incantation_source
  incantation ← understand_incantation source
  cast_incantation incantation
