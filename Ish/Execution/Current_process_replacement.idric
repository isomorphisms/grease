module Ish.Execution.Current_process_replacement

import Data.Buffer
import Data.Text
import System.Errno

import Ish.Execution.Meaning
import Ish.Source.Meaning

input_without_location : Input → Text
input_without_location (Input_at text _) = text

-- Preparing the replacement is the explicit point where an incantation name
-- becomes an exact executable path. Milestone 0 performs no PATH search.
export
prepare_process_replacement : Incantation → Current_process_replacement
prepare_process_replacement
  (Named_incantation_at source _ (Incantation_name_at name span) inputs) =
    let executable = Exact_executable_path name span
        input_texts = map input_without_location inputs in
      Replace_current_process_with source executable input_texts

-- The length framing exists only because the C foreign boundary cannot accept
-- List Text. It is not source syntax and is not exposed as a shell value.
encode_input : Text → Text
encode_input text =
  let byte_count = show $ stringByteLength text in
    byte_count ++ ":" ++ text

encode_inputs : List Text → Text
encode_inputs inputs =
  let input_count = show $ length inputs
      encoded_inputs = fastConcat $ map encode_input inputs in
    input_count ++ ":" ++ encoded_inputs

%foreign "C:ish_execve, libish_runtime"
execute_primitive :
  Text → Text → PrimIO Int

-- A successful launch cannot produce an Idriç value: execve replaces this
-- process. The only value returned by this action therefore denotes failure.
export
replace_current_process :
  Current_process_replacement → IO Process_replacement_failure
replace_current_process replacement = do
  let Replace_current_process_with _ path inputs = replacement
      executable_text = path_text path
      encoded_inputs = encode_inputs inputs
  foreign_error ← primIO $ execute_primitive executable_text encoded_inputs
  let error_text = strerror foreign_error
  pure $
    Could_not_replace_process replacement $
      Operating_system_error_reported error_text

export
replacement_failure_text : Process_replacement_failure → Text
replacement_failure_text
  (Could_not_replace_process
    (Replace_current_process_with
      (Source_from_file (Source_at_path source_path) _)
      (Exact_executable_path path span)
      _)
    (Operating_system_error_reported error_text)) =
    "could not cast incantation from " ++ show source_path ++
    ": could not replace ish with executable " ++ show path ++
    " at " ++ show span ++ ": " ++ error_text
