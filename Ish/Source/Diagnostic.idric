module Ish.Source.Diagnostic

import Ish.Source.Meaning

export
source_issue_text : Source_issue → Text
source_issue_text (Nul_in_source_at span) =
  "source contains NUL text at " ++ show span ++
  "; Unix process inputs cannot represent NUL"

export
decoding_issue_text : Source_decoding_issue → Text
decoding_issue_text (Invalid_utf8_near_byte byte) =
  "source is not UTF-8 near byte " ++ show byte
