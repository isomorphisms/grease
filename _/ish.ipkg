package ish

sourcedir = "src"

modules = Ish.Number, Ish.Text, Ish.Source.Meaning, Ish.Source.Utf_8,
          Ish.Source.Incantation, Ish.Source.Diagnostic,
          Ish.Execution.Meaning, Ish.Execution.Status,
          Ish.Execution.Current_process_replacement, Ish

main = Ish
executable = ish-backend

opts = "--codegen chez"
